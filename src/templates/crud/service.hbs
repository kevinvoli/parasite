import { Injectable, NotFoundException } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository, In{{#if hasRelations}}, DataSource{{/if}} } from 'typeorm';
import { {{entityName}} } from './entities/{{entityFile}}.entity';
import { Create{{entityName}}Dto } from './dto/create-{{entityFile}}.dto';
import { Update{{entityName}}Dto } from './dto/update-{{entityFile}}.dto';
{{#each properties}}
  {{#if isRelation}}
import { {{relatedEntity}} } from "../{{kebabCase relatedEntity}}/entities/{{kebabCase relatedEntity}}.entity";
  {{/if}}
{{/each}}

@Injectable()
export class {{entityName}}Service {
   constructor(
    @InjectRepository({{entityName}})
    private readonly {{entityFile}}Repository: Repository<{{entityName}}>,
    {{#each properties}}
      {{#if (and isRelation (and (not isJoinColumn) (or (neq relationType "OneToOne") isOwningRelation)))}}
        {{#if (or (neq relationType "ManyToMany") isOwningRelation)}}
    @InjectRepository({{relatedEntity}})
    private readonly {{relationFieldName}}Repository: Repository<{{relatedEntity}}>,
        {{/if}}
      {{/if}}
    {{/each}}
    {{#if hasRelations}}
    private readonly dataSource: DataSource,
    {{/if}}
  ) {}

  async create(createDto: Create{{entityName}}Dto): Promise<{{entityName}}> {
    {{#if hasRelations}}
    const {
      {{#each properties}}
        {{#if (and isRelation (not isJoinColumn))}}
          {{#if (or (eq relationType "ManyToOne") (and (eq relationType "OneToOne") isOwningRelation))}}
      {{relationFieldName}}Id,
          {{else if (or (eq relationType "OneToMany") (and (eq relationType "ManyToMany") isOwningRelation))}}
      {{relationFieldName}}Ids,
          {{/if}}
        {{/if}}
      {{/each}}
      ...rest
    } = createDto;

    return await this.dataSource.transaction(async (manager) => {
      const entity = manager.create({{entityName}}, rest);

      {{#each properties}}
        {{#if (and isRelation (not isJoinColumn))}}
          {{#if (or (eq relationType "ManyToOne") (and (eq relationType "OneToOne") isOwningRelation))}}
      if ({{relationFieldName}}Id) {
        entity.{{relationFieldName}} = await manager.findOneBy({{relatedEntity}}, { id: {{relationFieldName}}Id });
      }
          {{else if (or (eq relationType "OneToMany") (and (eq relationType "ManyToMany") isOwningRelation))}}
      if ({{relationFieldName}}Ids) {
        entity.{{relationFieldName}} = await manager.find({{relatedEntity}}, { where: { id: In({{relationFieldName}}Ids) } });
      }
          {{/if}}
        {{/if}}
      {{/each}}

      return await manager.save(entity);
    });
    {{else}}
    const entity = this.{{entityFile}}Repository.create(createDto);
    return await this.{{entityFile}}Repository.save(entity);
    {{/if}}
  }

  async findAll(pagination?: { page?: number; limit?: number }): Promise<[{{entityName}}[], number]> {
    const page = pagination?.page ?? 1;
    const limit = Math.min(pagination?.limit ?? 20, 100);
    const skip = (page - 1) * limit;

    return await this.{{entityFile}}Repository.findAndCount({
      {{#if hasRelations}}
      relations: [{{#each relations}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}],
      {{/if}}
      skip,
      take: limit,
    });
  }

  async findOne(id: number): Promise<{{entityName}}> {
    const entity = await this.{{entityFile}}Repository.findOne({
      where: { id },
      {{#if hasRelations}}
      relations: [{{#each relations}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}],
      {{/if}}
    });

    if (!entity) {
      throw new NotFoundException('{{entityName}} not found');
    }

    return entity;
  }

  async update(id: number, updateDto: Update{{entityName}}Dto): Promise<{{entityName}}> {
    {{#if hasRelations}}
    const {
      {{#each properties}}
        {{#if (and isRelation (not isJoinColumn))}}
          {{#if (or (eq relationType "ManyToOne") (and (eq relationType "OneToOne") isOwningRelation))}}
      {{relationFieldName}}Id,
          {{else if (or (eq relationType "OneToMany") (and (eq relationType "ManyToMany") isOwningRelation))}}
      {{relationFieldName}}Ids,
          {{/if}}
        {{/if}}
      {{/each}}
      ...rest
    } = updateDto;

    return await this.dataSource.transaction(async (manager) => {
      const entity = await manager.findOne({{entityName}}, {
        where: { id },
        relations: { {{#each relations}}{{this}}: true{{#unless @last}}, {{/unless}}{{/each}} },
      });

      if (!entity) {
        throw new NotFoundException('{{entityName}} not found');
      }

      Object.assign(entity, rest);

      {{#each properties}}
        {{#if (and isRelation (not isJoinColumn))}}
          {{#if (or (eq relationType "ManyToOne") (and (eq relationType "OneToOne") isOwningRelation))}}
      if ({{relationFieldName}}Id !== undefined) {
        entity.{{relationFieldName}} = {{relationFieldName}}Id ? await manager.findOneBy({{relatedEntity}}, { id: {{relationFieldName}}Id }) : null;
      }
          {{else if (or (eq relationType "OneToMany") (and (eq relationType "ManyToMany") isOwningRelation))}}
      if ({{relationFieldName}}Ids !== undefined) {
        entity.{{relationFieldName}} = {{relationFieldName}}Ids.length > 0 ? await manager.find({{relatedEntity}}, { where: { id: In({{relationFieldName}}Ids) } }) : [];
      }
          {{/if}}
        {{/if}}
      {{/each}}

      await manager.save(entity);
      return entity;
    });
    {{else}}
    await this.{{entityFile}}Repository.update(id, updateDto);
    return this.findOne(id);
    {{/if}}
  }

  async remove(id: number): Promise<void> {
    const entity = await this.{{entityFile}}Repository.findOne({
      where: { id },
    });

    if (!entity) {
      throw new NotFoundException('{{entityName}} not found');
    }

    const result = await this.{{entityFile}}Repository.delete(entity.id);
    if (result.affected === 0) {
      throw new NotFoundException('{{entityName}} not found');
    }
  }
}
