export class Create{{entityName}}Dto {
  {{#each properties}}
    {{#unless isPrimary}}
      {{#unless isJoinColumn}}
        {{#if isRelation}}
          {{#if (or (eq relationType "ManyToOne") (and (eq relationType "OneToOne") isOwningRelation))}}
  {{relationFieldName}}Id{{#if isOptional}}?{{/if}}: number;
          {{else if (or (eq relationType "OneToMany") (and (eq relationType "ManyToMany") isOwningRelation))}}
  {{relationFieldName}}Ids{{#if isOptional}}?{{/if}}: number[];
          {{/if}}
        {{else}}
  {{name}}{{#if isOptional}}?{{/if}}: {{dtoType}};
        {{/if}}
      {{/unless}}
    {{/unless}}
  {{/each}}
}
